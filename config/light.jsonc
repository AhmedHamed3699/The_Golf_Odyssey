      //       "material": "wood"
      //     }
      //   ]
      // },
      // {
      //   "position": [-5, 0, 0],
      //   "rotation": [0, 90, 0],
      //   "scale": [10, 10, 1],
      //   "components": [
      //     {
      //       "type": "Mesh Renderer",
      //       "mesh": "plane",
      //       "material": "wood"
      //     }
      //   ]
      // },
      // {
      //   "position": [5, 0, 0],
      //   "rotation": [0, 90, 0],
      //   "scale": [10, 10, 1],
      //   "components": [
      //     {
      //       "type": "Mesh Renderer",
      //       "mesh": "plane",
      //       "material": "wood"
      //     }
      //   ]
      // },
      // {
      //   "position": [0, 0, -10],
      //   "rotation": [0, 180, 90],
      //   "scale": [10, 10, 1],
      //   "components": [
      //     {
      //       "type": "Mesh Renderer",
      //       "mesh": "plane",
      //       "material": "wood"
      //     }
      //   ]
      // },
      {
        "position": [2, 0, 0],
        "rotation": [90, 0, 0],
        "components": [
          {
            "type": "Lights",
            "lights": [
              {
                "type": "SPOT",
                "color": [1.0, 0.0, 0.0],
                "enabled": true,
                "spotAngle": {
                  "inner": 60.0,
                  "outer": 100.0
                }
              }
            ]
          }
        ]
      },
      {
        "rotation": [-90, 0, 0],
        "components": [
          {
            "type": "Lights",
            "lights": [
              {
                "type": "DIRECTIONAL",
                "color": [0, 0, 1],
                "enabled": true
              }
            ]
          }
        ]
      },
      {
        "position": [0, 0, 0],
        "components": [
          {
            "type": "Mesh Renderer",
            "mesh": "monkey",
            "material": "metal"
          },
          {
            "type": "Movement",
            "angularVelocity": [0, 90, 0]
          }
        ]
      },
      {
        "position": [0, 4, 0],
        "rotation": [45, 45, 0],
        "scale": [1, 1, 1],
        "components": [
          {
            "type": "Mesh Renderer",
            "mesh": "sphere",
            "material": "moon"
          },
          {
            "type": "Lights",
            "lights": [
              {
                "type": "POINT",
                "enabled": true,
                "color": [0, 1, 0],
                "attenuation": {
                  "constant": 0,
                  "linear": 1,
                  "quadratic": 0
                }
              }
            ]
          }
        ]
      }
    ]
  }
